<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!--    represents the roundness of the view on all four sides-->
    <corners android:radius="30dp" />

    <!--    This represents the thin edge round the shape-->
    <!--    it has an attribute of width, which is the wideness, and colour-->
    <stroke
        android:width="1dp"
        android:color="@color/black" />

    <!--    Solid refers to the colour of the background within the shape-->
    <solid android:color="#FFEB3B" />
</shape>
