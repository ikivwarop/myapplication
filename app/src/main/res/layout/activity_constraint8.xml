<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ConstraintActivity8">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/image_9"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/image_9"/>
    
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/get_your"
        android:text="Get your groceries with nectar"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/image_9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="24dp"/>
    
    <ImageView
        android:layout_width="24dp"
        android:layout_height="20dp"
        android:id="@+id/flag"
        android:src="@drawable/baseline_grid_view_24"
        app:layout_constraintTop_toBottomOf="@id/get_your"
        app:layout_constraintStart_toStartOf="@id/get_your"
        android:layout_marginTop="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+91"
        android:textSize="16sp"
        android:id="@+id/code"
        app:layout_constraintTop_toTopOf="@id/flag"
        app:layout_constraintBottom_toBottomOf="@id/flag"
        app:layout_constraintStart_toEndOf="@id/flag"
        android:layout_marginStart="8dp"/>
    
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#CCCCCC"
        app:layout_constraintTop_toBottomOf="@id/flag"
        app:layout_constraintStart_toStartOf="@id/flag"
        app:layout_constraintEnd_toEndOf="@id/get_your"
        android:layout_marginTop="8dp"
        android:id="@+id/divider"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Or connect with social media"
        android:textSize="15sp"
        android:id="@+id/or_connect"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>



        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:id="@+id/googleBtn"
            app:layout_constraintTop_toBottomOf="@id/or_connect"
            app:layout_constraintStart_toStartOf="@id/get_your"
            app:layout_constraintEnd_toEndOf="@id/get_your"
            android:layout_marginTop="24dp"
            android:background="#5A8DEE">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="G"
                android:id="@+id/google_icon"
                android:textStyle="bold"
                android:textSize="19sp"
                app:layout_constraintStart_toStartOf="@id/googleBtn"
                app:layout_constraintBottom_toBottomOf="@id/googleBtn"
                app:layout_constraintTop_toTopOf="@id/googleBtn"
                android:layout_marginStart="16dp"
                android:textColor="@color/white"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/google_text"
                android:text="Continue with Google"
                android:textSize="16sp"
                app:layout_constraintStart_toEndOf="@id/google_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginStart="15dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:id="@+id/facebook_Btn"
            android:background="#3B5998"
            app:layout_constraintTop_toBottomOf="@id/googleBtn"
            app:layout_constraintStart_toStartOf="@id/googleBtn"
            app:layout_constraintEnd_toEndOf="@id/googleBtn"
            android:layout_marginTop="16dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="F"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:id="@+id/facebook_icon"
                app:layout_constraintStart_toStartOf="@id/facebook_Btn"
                app:layout_constraintTop_toTopOf="@id/facebook_Btn"
                app:layout_constraintBottom_toBottomOf="@id/facebook_Btn"
                android:layout_marginStart="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Continue with facebook"
        android:id="@+id/facebook_text"
        app:layout_constraintStart_toEndOf="@id/facebook_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="12dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>