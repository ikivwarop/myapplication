<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    tools:context=".search.FilterActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        android:padding="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/apply_button"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">




            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Filters"
                android:id="@+id/filters"
                android:textStyle="bold"
                android:textSize="25sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:id="@+id/close_button"
                android:src="@drawable/cance"
                app:layout_constraintTop_toTopOf="@id/filters"
                app:layout_constraintBottom_toBottomOf="@id/filters"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categories"
                android:textSize="20sp"
                android:textStyle="bold"
                android:id="@+id/categories"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/close_button"
                android:layout_marginTop="30dp"/>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/eggs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Eggs"
                android:textSize="16sp"
                android:buttonTint="#FF8C00"
                app:layout_constraintTop_toBottomOf="@id/categories"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="15dp"/>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/noodle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Noodles and Pasta"
                android:textSize="16sp"
                android:buttonTint="#FF8C00"
                app:layout_constraintTop_toBottomOf="@id/eggs"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="15dp"/>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chips and Crisps"
                android:textSize="16sp"
                android:buttonTint="#FF8C00"
                app:layout_constraintTop_toBottomOf="@id/noodle"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="15dp"/>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/fast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fast Food"
                android:textSize="16sp"
                android:buttonTint="#FF8C00"
                app:layout_constraintTop_toBottomOf="@id/chips"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="15dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Brand"
                android:textSize="20sp"
                android:textStyle="bold"
                android:id="@+id/brand"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/fast"
                android:layout_marginTop="30dp"/>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/individual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Individual Collection"
                android:textSize="16sp"
                android:buttonTint="#FF8C00"
                app:layout_constraintTop_toBottomOf="@id/brand"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="15dp"/>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/coca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cocacola"
                android:textSize="16sp"
                android:buttonTint="#FF8C00"
                app:layout_constraintTop_toBottomOf="@id/individual"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="15dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>


    <com.google.android.material.button.MaterialButton
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:id="@+id/apply_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cornerRadius="4dp"
        android:layout_margin="20dp"
        android:backgroundTint="#FF8C00"
        android:textSize="16sp"
        android:padding="16dp"
        android:text="Apply Filters"/>


</androidx.constraintlayout.widget.ConstraintLayout>