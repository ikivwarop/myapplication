<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SinginConstraint">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"

        app:layout_constraintBottom_toBottomOf="parent"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/scrollview_child">








        <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/image_9"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toTopOf="@id/scrollview_child"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:id="@+id/top_image"/>

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Get your groceries with nectar"
        app:layout_constraintTop_toBottomOf="@id/top_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:textColor="#FF5722"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:id="@+id/get_your"
        android:lineSpacingExtra="4dp"/>

    <com.google.android.material.textfield.TextInputLayout
    android:layout_width="80dp"
    android:layout_height="wrap_content"
    android:id="@+id/country_code_layout"
    app:layout_constraintTop_toBottomOf="@id/get_your"
    app:layout_constraintStart_toStartOf="parent"
    android:layout_marginStart="35dp"


        app:boxCornerRadiusTopStart="10dp"
        app:boxCornerRadiusTopEnd="10dp"
        app:boxCornerRadiusBottomStart="10dp"
        app:boxCornerRadiusBottomEnd="10dp"
    android:layout_marginTop="24dp">
    <com.google.android.material.textfield.TextInputEditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+234"
        android:textColor="#FF5722"
        android:textStyle="bold"
        android:inputType="none"
        android:id="@+id/country_code_edit"
        android:focusable="false"
        android:cursorVisible="false"
        android:clickable="true"/>
</com.google.android.material.textfield.TextInputLayout>




    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Or connect with social media"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FF5722"
        android:id="@+id/or_connect"
        app:layout_constraintTop_toBottomOf="@id/country_code_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"/>


    <com.google.android.material.button.MaterialButton
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:id="@+id/googleBtn"
        android:text="Continue with Google"
        android:textColor="#FF5722"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:backgroundTint="#5383EC"
        app:icon="@drawable/google"
        app:iconGravity="textStart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:iconPadding="16dp"
        app:layout_constraintTop_toBottomOf="@id/or_connect"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:cornerRadius="16dp"
        app:iconTint="@null"/>

    <com.google.android.material.button.MaterialButton
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toBottomOf="@id/googleBtn"
        app:layout_constraintStart_toStartOf="@id/googleBtn"
        app:layout_constraintEnd_toEndOf="@id/googleBtn"
        app:icon="@drawable/facebook"
        app:iconGravity="textStart"
        android:id="@+id/facebookBtn"
        android:textColor="#FF5722"
        app:cornerRadius="16dp"
        android:layout_marginTop="16dp"
        android:text="Continue with Facebook"
        app:iconPadding="16dp"
        android:backgroundTint="#5383EC"
        android:textAllCaps="false"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>



</androidx.constraintlayout.widget.ConstraintLayout>