<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:gravity="center"
    tools:context=".RelativeActivity1">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Hello"
        android:textSize="20sp"
        android:textStyle="bold"
        android:id="@+id/hello_label"
        android:layout_marginBottom="30dp"
        android:layout_alignParentTop="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Hello 2"
        android:textStyle="bold"
        android:textSize="20sp"
        android:id="@+id/hello_2"
        android:layout_below="@+id/hello_label"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Hello 3"
        android:textSize="20sp"
        android:textStyle="bold"
        android:id="@+id/hello_3"
        android:layout_below="@id/hello_2"
        android:layout_marginTop="30dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Hello 4"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_below="@+id/hello_3"
        android:layout_marginTop="20dp"
        android:layout_alignParentBottom="true"/>


</RelativeLayout>