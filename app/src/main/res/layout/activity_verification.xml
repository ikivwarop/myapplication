<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".auth.VerificationActivity">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/backarrow"
        app:layout_constraintStart_toStartOf="parent"
        android:id="@+id/backarrow"
        android:layout_marginStart="10dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="30dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter your 4-digit code"
        app:layout_constraintTop_toBottomOf="@id/backarrow"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="10dp"
        android:layout_marginTop="20dp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:id="@+id/enter_your"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Code"
        app:layout_constraintTop_toBottomOf="@id/enter_your"
        android:layout_marginTop="30dp"
        android:layout_marginStart="10dp"
        android:id="@+id/code"
        app:layout_constraintStart_toStartOf="parent"
        android:textColor="#999999"
        android:textStyle="bold"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"

        android:layout_marginTop="15dp"
        android:id="@+id/otpContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/code">

        <EditText
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:cursorVisible="false"
            android:importantForAutofill="no"
            android:textAlignment="center"
            android:textSize="24sp"
            android:background="@drawable/otp_box"
            android:layout_margin="6dp"
            android:id="@+id/otp1" />

        <EditText
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:gravity="center"
            android:inputType="number"
            android:cursorVisible="false"
            android:importantForAutofill="no"
            android:textAlignment="center"
            android:maxLength="1"
            android:layout_margin="6dp"
            android:background="@drawable/otp_box"
            android:textSize="24sp"
            android:id="@+id/otp2"/>

        <EditText
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:gravity="center"
            android:inputType="number"
            android:cursorVisible="false"
            android:importantForAutofill="no"
            android:textAlignment="center"
            android:layout_margin="6dp"
            android:background="@drawable/otp_box"
            android:maxLength="1"
            android:textSize="24sp"
            android:id="@+id/otp3"/>

        <EditText
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:gravity="center"
            android:inputType="number"
            android:cursorVisible="false"
            android:importantForAutofill="no"
            android:textAlignment="center"
            android:maxLength="1"
            android:layout_margin="6dp"
            android:background="@drawable/otp_box"
            android:textSize="24sp"
            android:id="@+id/otp4"/>
    </LinearLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:layout_constraintTop_toBottomOf="@id/otpContainer"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Resend Code"
            android:id="@+id/resend_code"
            android:layout_gravity="center_vertical"
            android:textColor="#FF5722"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="20dp"
            android:textSize="14sp"/>

        <LinearLayout
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:orientation="vertical"
            android:id="@+id/next_button"
            android:layout_gravity="center_vertical"
            android:gravity="center"
            android:layout_marginEnd="10dp"
            android:background="@drawable/circle_button"
            android:clickable="true"
            android:focusable="true">

            <View
                android:layout_width="10dp"
                android:layout_height="18dp"
                android:background="@drawable/arrow_right_white"/>

        </LinearLayout>

    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>