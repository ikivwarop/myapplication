<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="150dp"
    android:background="#F8C1AF"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clickable="true"
    android:layout_marginTop="10dp"
    android:layout_margin="10dp"

    android:padding="16dp"
    android:focusable="true">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:id="@+id/product_pluses_image3"
        android:src="@drawable/pluses"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/product_pluses_name3"
        app:layout_constraintStart_toEndOf="@id/product_pluses_image3"

        android:layout_marginStart="15dp"
        android:textStyle="bold"
        android:textSize="25sp"
        app:layout_constraintTop_toTopOf="@id/product_pluses_image3"
        app:layout_constraintBottom_toBottomOf="@id/product_pluses_image3"/>




</androidx.constraintlayout.widget.ConstraintLayout>